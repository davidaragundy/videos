    {
      "scene": "02-wind",
      "event": "ripples",
      "start": 9.418,
      "end": 13.703,
      "file": "lines/recorded/04-ripples.m4a",
      "text": "Wind dragged across the sea and raised ripples, and every ripple gave it more to push."
