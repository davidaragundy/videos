    {
      "scene": "04-math",
      "event": "speed",
      "start": 31.781,
      "end": 37.354,
      "file": "lines/recorded/09-speed.m4a",
      "text": "In deep water, longer waves travel faster. Their speed grows with the square root of the wavelength."
