# Copy to .env (git-ignored) and fill in. Used by `pnpm voice <slug>`.
# Only the provider you use needs a key. Per-video overrides go in script.md front-matter:
#   voice_provider: fish   voice_id: '...'   model_id: '...'   voice_style: '...'

# Default provider: elevenlabs | fish | openai | google | recorded  (or pass --provider)
# recorded = your own takes in videos/<slug>/audio/lines/recorded/ (no key needed)
VOICE_PROVIDER=elevenlabs
# Delivery direction for providers that support it (OpenAI gpt-4o-mini-tts).
VOICE_STYLE=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Fish Audio — https://fish.audio/app/api-keys
# s2.1-pro-free is the free developer tier (no SLA; s2.1-pro for paid).
# VOICE_ID = a voice model id from fish.audio (empty = their default voice).
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL_ID=s2.1-pro-free

# OpenAI — https://platform.openai.com/api-keys
# Voices: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_API_KEY=
OPENAI_VOICE_ID=onyx
OPENAI_MODEL_ID=gpt-4o-mini-tts

# Google Cloud Text-to-Speech — API key with the Text-to-Speech API enabled
# https://console.cloud.google.com/apis/credentials  (voice list: cloud.google.com/text-to-speech/docs/voices)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_ID=en-US-Chirp3-HD-Charon
